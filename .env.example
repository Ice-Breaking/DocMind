# 复制本文件为 .env 并填入真实配置（.env 已被 gitignore，不会上传）

# 百炼（阿里云 DashScope）API Key
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI 兼容模式接入点（默认即可）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型：qwen-plus 工具调用更稳定，qwen-turbo 更便宜但可能不主动调工具
CHAT_MODEL=qwen-flash

# 语义缓存（高频问题秒回）；阈值保守，宁可不命中不可错配
SEMANTIC_CACHE=true
CACHE_THRESHOLD=0.92

# 向量模型（RAG 用）
EMBEDDING_MODEL=text-embedding-v3

# Agent 最大推理步数（防死循环）
MAX_AGENT_STEPS=8

# 深度思考（可选）：开启后请求百炼思维链（enable_thinking），GUI 实时展示
# 模型真实推理过程；模型不支持时自动降级关闭，不影响主链路
ENABLE_THINKING=true

# 联网搜索（可选，逐级降级）：
# Tavily：质量优先，tavily.com 注册免费 1000 次/月
TAVILY_API_KEY=
# SearXNG：自托管元搜索引擎（docker compose 已含该服务，免费无限量）
# 本地开发用 http://localhost:8080；compose 容器内会被自动覆盖为 http://searxng:8080
SEARXNG_URL=

# 调用链追踪（可选）：配置后上报 Langfuse（云或自托管）；
# 不配置则自动降级写本地 data/trace_log.jsonl（python scripts/view_traces.py 查看）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
