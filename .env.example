# 复制本文件为 .env 并填入真实配置（.env 已被 gitignore，不会上传）

# 百炼（阿里云 DashScope）API Key
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI 兼容模式接入点（默认即可）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型：qwen-plus 工具调用更稳定，qwen-turbo 更便宜但可能不主动调工具
CHAT_MODEL=qwen-plus

# 向量模型（RAG 用）
EMBEDDING_MODEL=text-embedding-v3

# Agent 最大推理步数（防死循环）
MAX_AGENT_STEPS=8

# 联网搜索（可选）：配置后优先用博查（国内稳定、新鲜度高，bochaai.com 有免费额度）；
# 不配置则回退 DuckDuckGo（免 Key，国内网络下时好时坏）
BOCHA_API_KEY=

# 调用链追踪（可选）：配置后上报 Langfuse（云或自托管）；
# 不配置则自动降级写本地 data/trace_log.jsonl（python scripts/view_traces.py 查看）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
