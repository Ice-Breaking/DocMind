# 复制本文件为 .env 并填入真实配置（.env 已被 gitignore，不会上传）

# 百炼（阿里云 DashScope）API Key
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI 兼容模式接入点（默认即可）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型：qwen-plus 工具调用更稳定，qwen-turbo 更便宜但可能不主动调工具
CHAT_MODEL=qwen-plus

# 向量模型（RAG 用）
EMBEDDING_MODEL=text-embedding-v3

# Agent 最大推理步数（防死循环）
MAX_AGENT_STEPS=8
