# 复制本文件为 .env 并填入真实配置（.env 已被 gitignore，不会上传）

# 百炼（阿里云 DashScope）API Key
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI 兼容模式接入点（默认即可）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型：qwen-plus 工具调用更稳定，qwen-turbo 更便宜但可能不主动调工具
CHAT_MODEL=qwen-flash

# 最大输出 token 数：防止回复被截断（qwen-turbo 默认 1500，qwen-max 支持 8000）
MAX_OUTPUT_TOKENS=2000

# 语义缓存（高频问题秒回）；阈值保守，宁可不命中不可错配
SEMANTIC_CACHE=true
CACHE_THRESHOLD=0.92

# 向量模型（RAG 用）
EMBEDDING_MODEL=text-embedding-v3

# Agent 最大推理步数（防死循环）
MAX_AGENT_STEPS=8

# 深度思考（可选）：开启后请求百炼思维链（enable_thinking），GUI 实时展示
# 模型真实推理过程；模型不支持时自动降级关闭，不影响主链路
ENABLE_THINKING=true

# 联网搜索（可选，逐级降级）：
# Tavily：质量优先，tavily.com 注册免费 1000 次/月
TAVILY_API_KEY=
# Serper.dev：Google Search API，免费 2500 次/月，https://serper.dev
SERPER_API_KEY=
# Azure Bing Search API：企业级稳定性（需订阅）
BING_SEARCH_KEY=
# SearXNG：自托管元搜索引擎（docker compose 已含该服务，免费无限量）
# 本地开发用 http://localhost:8080；compose 容器内会被自动覆盖为 http://searxng:8080
SEARXNG_URL=
# 搜索引擎超时（秒）和缓存时间（秒）
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_CACHE_TTL=1800

# 调用链追踪（可选）：配置后上报 Langfuse（云或自托管）；
# 不配置则自动降级写本地 data/trace_log.jsonl（python scripts/view_traces.py 查看）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 证据拒答（RetrievalOps）：true 时知识库无证据则确定性拒答，防幻觉
EVIDENCE_REFUSAL=false

# 企业 LDAP 登录（两者都填才启用；本地账号始终优先）
#LDAP_URL=ldap://ldap.example.com:389
#LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com

# 告警阈值
#ALERT_INTERVAL_MIN=10
#ALERT_BADCASE_PENDING=5
#ALERT_DAILY_COST=10.0
#ALERT_ERROR_COUNT=10
