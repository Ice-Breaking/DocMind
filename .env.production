# ============================================================
# DocMind 生产环境配置模板
# ============================================================
# 使用方法：
#   cp .env.production .env
#   然后填入真实配置值（特别是标注 [必填] 的项）
#
# ⚠️  本文件是模板，不含真实密钥，可安全提交到 git
# ============================================================

# ── 大模型 API ──────────────────────────────────────────────

# [必填] 百炼（阿里云 DashScope）API Key
# 获取：https://bailian.console.aliyun.com/ → API Key 管理
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI 兼容模式接入点（通常无需修改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型
# qwen-plus  ：工具调用更稳定，推荐生产使用
# qwen-flash ：性价比高，适合开发测试
# qwen-turbo ：最便宜但可能不主动调工具
CHAT_MODEL=qwen-plus

# ── 语义缓存 ────────────────────────────────────────────────

# 高频问题秒回（embedding 余弦相似度 ≥ 阈值直接返回缓存）
# 生产建议保持开启，可显著降低 API 调用成本
SEMANTIC_CACHE=true

# 缓存命中阈值（保守值，宁可不命中不可错配）
CACHE_THRESHOLD=0.92

# ── 向量模型（RAG 知识库检索）────────────────────────────────

EMBEDDING_MODEL=text-embedding-v3

# ── Agent 控制 ──────────────────────────────────────────────

# 最大推理步数（防止工具调用死循环，生产环境建议 8-12）
MAX_AGENT_STEPS=8

# ── 深度思考（可选）──────────────────────────────────────────

# 开启后请求百炼思维链（enable_thinking），GUI 实时展示模型真实推理过程
# 模型不支持时自动降级关闭，不影响主链路
ENABLE_THINKING=true

# ── 联网搜索（可选，逐级降级）────────────────────────────────

# Tavily：质量优先，https://tavily.com 注册免费 1000 次/月
# [推荐] 生产环境建议配置，搜索质量最佳
TAVILY_API_KEY=

# SearXNG：自托管元搜索引擎（docker compose 已含该服务，免费无限量）
# Docker 部署时无需配置（compose 自动注入 http://searxng:8080）
# 本地开发用 http://localhost:8080
SEARXNG_URL=
# SearXNG 实例密钥（生产必填，生成：openssl rand -hex 32）
SEARXNG_SECRET=
# Prometheus /metrics 抓取令牌（生产必填；留空时 metrics 仅限本机回环读取）
METRICS_TOKEN=

# ── 调用链追踪（可选）────────────────────────────────────────

# 配置后上报 Langfuse（云或自托管）；不配置则自动降级写本地 data/trace_log.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── 服务监听 ────────────────────────────────────────────────

# Docker 部署时必须为 0.0.0.0（容器内需对外暴露）
# 本地开发可用 127.0.0.1
GRADIO_SERVER_NAME=0.0.0.0

# ── 安全 ────────────────────────────────────────────────────

# [必填] 管理员初始密码（首次启动自动创建 admin 账号）
# ⚠️  生产环境务必设置强密码！留空则使用默认值 admin123（极不安全）
ADMIN_PASSWORD=
