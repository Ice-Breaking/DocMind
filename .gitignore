# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境变量（含 API Key，严禁提交）
.env

# RAG 索引缓存
data/index/

# IDE / 系统
.idea/
.vscode/
.DS_Store
.aicoding-chat-workspace
data/preview_cache/
data/ocr_cache/

# SQLite 数据库及 WAL/SHM 附属文件（运行时数据，不入库）
*.db
*.db-shm
*.db-wal

# 运行时数据不入库（含会话 trace 日志）
data/trace_log.jsonl
data/backups/

# 测试缓存与前端构建产物
.pytest_cache/
*.tsbuildinfo
node_modules/

# 前端构建产物（本地构建即可，不入库；web/.gitignore 同步忽略）
web/dist/

# 运行时用户数据不入库（聊天上传图片 / 头像 / 知识库入库文档副本）
data/uploads/
data/avatars/
data/kb_docs/
