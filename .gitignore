# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境变量（含 API Key，严禁提交）
.env

# IDE / 系统
.idea/
.vscode/
.DS_Store
.aicoding-chat-workspace

# SQLite 数据库及 WAL/SHM 附属文件（运行时数据，不入库）
*.db
*.db-shm
*.db-wal

# data/ 整目录为运行时数据（chat.db 会话、向量索引、trace 日志、上传图片、
# 头像、入库文档副本、TTS/OCR 缓存、备份、e2e 报告），一律不入库。
# 历史教训：chroma.sqlite3 曾被误提交，知识库文档切片全文进了 git 历史
data/

# 备份压缩包（卷备份等，体积大且含用户数据）
*.tgz

# 测试缓存与前端构建产物
.pytest_cache/
*.tsbuildinfo
node_modules/

# 前端构建产物（本地构建即可，不入库；web/.gitignore 同步忽略）
web/dist/
